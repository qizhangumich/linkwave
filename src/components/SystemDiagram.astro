---
import { architecture } from '@/content/home';

interface Props {
  /** Node id selected on load. */
  active?: string;
}
const { active = 'centralized-cdu' } = Astro.props;

const loops = ['IT loop', 'Secondary loop', 'Primary loop'] as const;
const loopNotes: Record<(typeof loops)[number], string> = {
  'IT loop': 'Server to rack',
  'Secondary loop': 'Technology cooling system',
  'Primary loop': 'Facility water system',
};
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="sysdiagram" data-sysdiagram>
  <div class="sysdiagram__loops" aria-hidden="true">
    {
      loops.map((loop) => (
        <div class="sysdiagram__loop" data-loop-label={loop}>
          <span class="label">{loop}</span>
          <span class="small muted">{loopNotes[loop]}</span>
        </div>
      ))
    }
  </div>

  <ol class="sysdiagram__nodes">
    {
      architecture.map((node, i) => {
        const isActive = node.id === active;
        const firstOfLoop = i === 0 || architecture[i - 1].loop !== node.loop;
        return (
          <li class="node" data-loop={node.loop} data-first-of-loop={firstOfLoop ? '' : undefined}>
            {firstOfLoop && <p class="label node__loop mobile-loop">{node.loop}</p>}
            <button
              class="node__button"
              type="button"
              style={`--col: ${i + 1}`}
              data-node={node.id}
              data-kind={node.kind}
              aria-expanded={isActive ? 'true' : 'false'}
              aria-controls={`node-panel-${node.id}`}
            >
              <span class="node__pipe" aria-hidden="true">
                <span class="node__glyph" />
              </span>
              <span class="node__index label">{pad(i + 1)}</span>
              <span class="node__name">{node.short}</span>
              <span class="visually-hidden">, {node.loop}</span>
            </button>
            <div class="node__panel" id={`node-panel-${node.id}`} hidden={!isActive}>
              <div class="node__panel-head">
                <p class="label">
                  {pad(i + 1)} / {pad(architecture.length)} · {node.role}
                </p>
                <h3 class="h3">{node.name}</h3>
                <p class:list={['node__scope', node.scope === 'LINKWAVE scope' && 'node__scope--own']}>
                  {node.scope}
                </p>
              </div>
              <div class="node__panel-body">
                <p>{node.detail}</p>
                {node.href && (
                  <a class="btn btn--text" href={node.href}>
                    <span class="btn__label">View product</span>
                    <span class="btn__arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                )}
              </div>
            </div>
          </li>
        );
      })
    }
  </ol>

  <p class="sysdiagram__legend small muted">
    <span class="sysdiagram__flow" aria-hidden="true"></span>
    Heat travels from chip to heat rejection. Select a stage for detail.
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-sysdiagram]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.node__button')];
    const desktop = window.matchMedia('(min-width: 62rem)');
    const canHover = window.matchMedia('(hover: hover)');

    const select = (button: HTMLButtonElement | null) => {
      const loop = button?.closest<HTMLElement>('.node')?.dataset.loop;
      buttons.forEach((b) => {
        const on = b === button;
        b.setAttribute('aria-expanded', String(on));
        const panel = document.getElementById(b.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
        b.closest<HTMLElement>('.node')?.toggleAttribute(
          'data-in-flow',
          !!loop && b.closest<HTMLElement>('.node')?.dataset.loop === loop,
        );
      });
      root.querySelectorAll<HTMLElement>('[data-loop-label]').forEach((label) => {
        label.toggleAttribute('data-in-flow', label.dataset.loopLabel === loop);
      });
    };

    buttons.forEach((button, i) => {
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        // On phones the list is an accordion and a second tap closes it; on desktop one stage stays selected.
        select(open && !desktop.matches ? null : button);
      });
      button.addEventListener('pointerenter', () => {
        if (desktop.matches && canHover.matches) select(button);
      });
      button.addEventListener('keydown', (event) => {
        if (!desktop.matches) return;
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        const next = buttons[(i + step + buttons.length) % buttons.length];
        next.focus();
        select(next);
      });
    });

    select(buttons.find((b) => b.getAttribute('aria-expanded') === 'true') ?? null);
  });
</script>

<style>
  .sysdiagram {
    --pipe: var(--border-strong);
    --glyph: 0.875rem;
  }

  /* ---------- node glyphs (shared) ---------- */
  .node__glyph {
    position: relative;
    z-index: 1;
    display: block;
    width: var(--glyph);
    height: var(--glyph);
    border: 1.5px solid var(--text-primary);
    background: var(--surface-bg, var(--surface-secondary));
    transition:
      background-color var(--motion-fast) var(--ease),
      border-color var(--motion-fast) var(--ease),
      transform var(--motion-fast) var(--ease);
  }
  [data-kind='loop'] .node__glyph {
    border-radius: 50%;
  }
  [data-in-flow] .node__glyph {
    border-color: var(--accent);
  }
  [aria-expanded='true'] .node__glyph {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.3);
  }
  .node__button {
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }
  .node__name {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.25;
    transition: color var(--motion-fast) var(--ease);
  }
  [aria-expanded='true'] .node__name {
    color: var(--accent);
  }
  .node__scope {
    display: inline-block;
    padding: 0.25em 0.6em;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .node__scope--own {
    border-color: var(--accent);
    color: var(--accent);
  }
  .node__panel-body p {
    max-width: 36em;
    color: var(--text-secondary);
  }
  .node__panel-body .btn {
    margin-top: var(--space-6);
  }
  .sysdiagram__legend {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .sysdiagram__flow {
    flex: none;
    width: 2.5rem;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 10px);
    background-size: 10px 2px;
    animation: flow 700ms linear infinite;
  }
  @keyframes flow {
    to {
      background-position: 10px 0;
    }
  }
  @keyframes flow-down {
    to {
      background-position: 0 10px;
    }
  }

  /* ---------- desktop: horizontal schematic ---------- */
  @media (min-width: 62rem) {
    .mobile-loop {
      display: none;
    }
    .sysdiagram__loops {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .sysdiagram__loop {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: var(--space-3) 0 var(--space-8);
      border-top: 1px solid var(--border-subtle);
      transition: border-color var(--motion-standard) var(--ease);
    }
    .sysdiagram__loop + .sysdiagram__loop {
      padding-left: var(--space-4);
      border-left: 1px solid var(--border-subtle);
    }
    .sysdiagram__loop[data-in-flow] {
      border-top-color: var(--accent);
    }
    .sysdiagram__loop[data-in-flow] .label {
      color: var(--accent);
    }

    .sysdiagram__nodes {
      display: grid;
      grid-template-columns: repeat(9, minmax(0, 1fr));
    }
    .node {
      display: contents;
    }
    .node__button {
      grid-row: 1;
      grid-column: var(--col);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: 0 var(--space-3) var(--space-8) 0;
    }
    .node[data-first-of-loop]:not(:first-child) .node__button {
      padding-left: var(--space-4);
    }
    .node__pipe {
      position: relative;
      display: flex;
      align-items: center;
      height: 2rem;
      margin-right: calc(-1 * var(--space-3));
    }
    .node[data-first-of-loop]:not(:first-child) .node__pipe {
      margin-left: calc(-1 * var(--space-4));
      padding-left: var(--space-4);
    }
    .node__pipe::before {
      content: '';
      position: absolute;
      inset: 50% 0 auto;
      height: 2px;
      margin-top: -1px;
      background: var(--pipe);
      opacity: 0.25;
    }
    .node:last-child .node__pipe::before {
      right: calc(100% - var(--glyph));
    }
    .node[data-in-flow] .node__pipe::before {
      opacity: 1;
      background: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 10px);
      background-size: 10px 2px;
      animation: flow 700ms linear infinite;
    }
    .node__panel {
      grid-row: 2;
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      min-height: 13rem;
      padding-top: var(--space-8);
      border-top: 1px solid var(--border-strong);
    }
    .node__panel[hidden] {
      display: none;
    }
    .node__panel-head {
      grid-column: 1 / span 5;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
    .node__panel-body {
      grid-column: 7 / -1;
      font-size: var(--type-lead);
      line-height: 1.45;
    }
  }

  /* ---------- phone / tablet: vertical journey ---------- */
  @media (max-width: 61.99rem) {
    .sysdiagram__loops {
      display: none;
    }
    .node {
      position: relative;
      padding-left: 2.25rem;
    }
    .node::before {
      content: '';
      position: absolute;
      left: calc(var(--glyph) / 2 - 1px);
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--pipe);
      opacity: 0.25;
    }
    .node:first-child::before {
      top: 3.25rem;
    }
    .node:last-child::before {
      bottom: auto;
      height: 1.5rem;
    }
    .node[data-in-flow]::before {
      opacity: 1;
      background: repeating-linear-gradient(180deg, var(--accent) 0 6px, transparent 6px 10px);
      background-size: 2px 10px;
      animation: flow-down 700ms linear infinite;
    }
    .node__loop {
      padding-top: var(--space-6);
    }
    .node:first-child .node__loop {
      padding-top: 0;
    }
    .node__button {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      width: 100%;
      min-height: 3.25rem;
      padding-block: var(--space-3);
    }
    .node__pipe {
      position: absolute;
      left: 0;
      margin-top: 0.2rem;
    }
    .node__name {
      font-size: 1.25rem;
      letter-spacing: -0.02em;
    }
    .node__panel {
      padding-bottom: var(--space-6);
    }
    .node__panel-head .label,
    .node__panel-head .h3 {
      display: none;
    }
    .node__panel-head {
      margin-bottom: var(--space-3);
    }
  }

  /* Without JavaScript every stage is shown in sequence. */
  :global(html:not(.js)) .node__panel[hidden] {
    display: block !important;
  }
  :global(html:not(.js)) .node__panel {
    grid-row: auto;
    min-height: 0;
  }
</style>
