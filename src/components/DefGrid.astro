---
interface Props {
  items: { title: string; body: string }[];
  columns?: 2 | 3;
  numbered?: boolean;
}
const { items, columns = 3, numbered = false } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<dl class:list={['def-grid', `def-grid--${columns}`]}>
  {
    items.map((item, i) => (
      <div>
        <dt>
          {numbered && <span class="label">{pad(i + 1)}</span>}
          {item.title}
        </dt>
        <dd class="muted">{item.body}</dd>
      </div>
    ))
  }
</dl>

<style>
  .def-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--col-gap);
    margin: 0;
  }
  .def-grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .def-grid > div {
    padding-block: var(--space-6) var(--space-8);
    border-top: 1px solid var(--border-subtle);
  }
  .def-grid dt {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .def-grid dd {
    max-width: 28em;
  }
  @media (max-width: 61.99rem) {
    .def-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 47.99rem) {
    .def-grid,
    .def-grid--2 {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
