---
interface Props {
  /** `small` is the quiet plate used on images. */
  size?: 'default' | 'small';
}
const { size = 'default' } = Astro.props;
---

<span class:list={['logo', size === 'small' && 'logo--small']}>
  <svg class="logo__symbol" viewBox="0 0 44 24" fill="none" stroke-width="3.2" stroke-linecap="round" aria-hidden="true">
    <path d="M3 12C8 2.5 16 2.5 22 12s14 9.5 19 0" stroke="currentColor"></path>
    <path class="logo__wave" d="M3 12c5 9.5 13 9.5 19 0s14-9.5 19 0"></path>
  </svg>
  <span class="logo__word">LINKWAVE</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-size: 1.0625rem;
    line-height: 1;
  }
  .logo__symbol {
    width: 2.05em;
    height: auto;
  }
  .logo__wave {
    stroke: var(--accent);
  }
  .logo__word {
    font-weight: 600;
    letter-spacing: 0.14em;
  }
  .logo--small {
    font-size: 0.625rem;
    gap: 0.55em;
  }
</style>
