---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** CSS aspect-ratio for the frame, e.g. "16 / 10". Omit to use the image's own ratio. */
  ratio?: string;
  /** Portrait ratio used below 48rem so phones get a deliberate crop (spec §39.6). */
  mobileRatio?: string;
  position?: string;
  fit?: 'cover' | 'contain';
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  caption,
  ratio,
  mobileRatio,
  position = '50% 50%',
  fit = 'cover',
  sizes = '(min-width: 62rem) 60vw, 100vw',
  eager = false,
  class: cls,
} = Astro.props;

const widths = [480, 768, 1080, 1440, 1920, 2560].filter((w) => w <= src.width);
if (!widths.includes(src.width) && src.width < 2560) widths.push(src.width);
---

<figure class:list={['figure', cls]}>
  <div
    class:list={['figure__frame', fit === 'contain' && 'figure__frame--contain']}
    style={{
      '--ratio': ratio ?? `${src.width} / ${src.height}`,
      '--ratio-mobile': mobileRatio ?? ratio ?? `${src.width} / ${src.height}`,
      '--position': position,
    }}
  >
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding={eager ? 'sync' : 'async'}
    />
  </div>
  {caption && <figcaption class="figure__caption">{caption}</figcaption>}
</figure>

<style>
  .figure__frame {
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--surface-tertiary);
  }
  .figure__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--position);
  }
  .figure__frame--contain {
    background: var(--surface-primary);
  }
  .figure__frame--contain :global(img) {
    object-fit: contain;
  }
  .figure__caption {
    margin-top: var(--space-3);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-tertiary);
    max-width: 44em;
  }
  @media (max-width: 47.99rem) {
    .figure__frame {
      aspect-ratio: var(--ratio-mobile);
    }
  }
</style>
