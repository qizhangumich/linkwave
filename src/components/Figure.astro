---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Logo from './Logo.astro';
import { studio } from '@/content/imageMeta';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** CSS aspect-ratio for the frame, e.g. "16 / 10". Omit to use the image's own ratio. */
  ratio?: string;
  /** Portrait ratio used below 48rem so phones get a deliberate crop (spec §39.6). */
  mobileRatio?: string;
  position?: string;
  fit?: 'cover' | 'contain';
  sizes?: string;
  eager?: boolean;
  /** Small LINKWAVE plate in the corner of the image. Off for drawings and plots. */
  mark?: boolean;
  class?: string;
}

const {
  src,
  alt,
  caption,
  ratio,
  mobileRatio,
  position = '50% 50%',
  fit = 'cover',
  sizes = '(min-width: 62rem) 60vw, 100vw',
  eager = false,
  mark = fit === 'cover',
  class: cls,
} = Astro.props;

// Studio images are equipment cut out onto a flat backdrop: always shown whole, never cropped.
const studioMeta = studio.get(src);
const contain = fit === 'contain' || !!studioMeta;
const native = src.width / src.height;
const nativeRatio = `${src.width} / ${src.height}`;
const studioMobile = native > 4 / 3 ? '4 / 3' : nativeRatio;

const widths = [480, 768, 1080, 1440, 1920, 2560].filter((w) => w <= src.width);
if (!widths.includes(src.width) && src.width < 2560) widths.push(src.width);
---

<figure class:list={['figure', cls]}>
  <div
    class:list={[
      'figure__frame',
      contain && 'figure__frame--contain',
      studioMeta && 'figure__frame--studio',
    ]}
    style={{
      '--ratio': ratio ?? nativeRatio,
      '--ratio-mobile': studioMeta ? studioMobile : (mobileRatio ?? ratio ?? nativeRatio),
      '--position': studioMeta?.anchor ?? position,
    }}
  >
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding={eager ? 'sync' : 'async'}
    />
    {
      mark && (
        <span class="figure__mark" aria-hidden="true">
          <Logo size="small" />
        </span>
      )
    }
  </div>
  {caption && <figcaption class="figure__caption">{caption}</figcaption>}
</figure>

<style>
  .figure__frame {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--surface-tertiary);
  }
  .figure__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--position);
  }
  .figure__frame--contain {
    background: var(--surface-primary);
  }
  .figure__frame--contain :global(img) {
    object-fit: contain;
  }
  .figure__frame--studio {
    background: var(--surface-tertiary);
  }
  /* The mark is an overlay, not part of the photograph: the image files stay unaltered. */
  .figure__mark {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    padding: 0.5rem 0.625rem;
    background: var(--surface-inverse);
    color: var(--text-inverse);
    --accent: var(--accent-on-inverse);
  }
  .figure__caption {
    margin-top: var(--space-3);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-tertiary);
    max-width: 44em;
  }
  @media (max-width: 47.99rem) {
    .figure__frame {
      aspect-ratio: var(--ratio-mobile);
    }
  }
</style>
