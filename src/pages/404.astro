---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
---

<Base title="Page not found" stickyCta={false}>
  <section class="section">
    <div class="container notfound">
      <p class="label">Error 404</p>
      <h1 class="h1">This page does not exist.</h1>
      <p class="lead">The address may have changed. The homepage links to every section of the site.</p>
      <Button href="/">Go to the homepage</Button>
    </div>
  </section>
</Base>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }
</style>
